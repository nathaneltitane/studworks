<ui version="4.0">
 <class>swAboutDialog</class>
 <widget class="QDialog" name="swAboutDialog">
  <property name="whatsThis">
   <string>&lt;p&gt;&lt;b&gt;About StudWorks&lt;/b&gt;&lt;/p&gt;&lt;p&gt;View the StudWorks version and system information. The Qt and OpenGL details can help diagnose display problems. Select text in System Information to copy it when reporting a problem. The project page link opens in your browser.&lt;/p&gt;</string>
  </property>
