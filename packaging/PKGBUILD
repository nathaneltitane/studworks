# Maintainer: Peter Bartfai <pbartfai[at]stardust[dot]hu>
pkgname=studworks
pkgver=20261029
pkgrel=1
pkgdesc="StudWorks is a CAD program for creating virtual LEGO® models."
url="https://github.com/nathaneltitane/studworks"
arch=('x86_64' 'i686')
license=('GPL-3.0-only')
#Qt4.x
depends=('qt4' 'libpng' 'libjpeg-turbo' 'mesa-libgl')
#Qt5.x
#depends=('qt5-base' 'qt5-tools' 'qt5-gamepad' 'libpng' 'libjpeg-turbo' 'mesa-libgl')
makedepends=('glu' 'ca-certificates')
conflicts=()
replaces=()
backup=()
source=("studworks-git.tar.gz")
md5sums=(SKIP)

build() {
  cd ${srcdir}/studworks-git
  if test "$CARCH" == x86_64; then
    PLATFORM=linux-g++-64
  else
    PLATFORM=linux-g++-32
  fi
  if [ -x /usr/bin/qmake ] ; then qmake -spec $PLATFORM DISABLE_UPDATE_CHECK=1 LDRAW_LIBRARY_PATH=/usr/share/ldraw ; lrelease studworks.pro ;
  elif [ -x /usr/bin/qmake-qt4 ] ; then qmake-qt4 -spec $PLATFORM DISABLE_UPDATE_CHECK=1 LDRAW_LIBRARY_PATH=/usr/share/ldraw ; lrelease-qt4 studworks.pro ;
  elif [ -x /usr/bin/qmake-qt5 ] ; then qmake-qt5 -spec $PLATFORM DISABLE_UPDATE_CHECK=1 LDRAW_LIBRARY_PATH=/usr/share/ldraw ; lrelease-qt5 studworks.pro ; fi
  make 
}
 
package() {
  cd "${srcdir}/studworks-git"
  mkdir -p ${pkgdir}/usr/bin
  mkdir -p ${pkgdir}/usr/share/studworks
  install -m 755 build/release/studworks ${pkgdir}/usr/bin
  install -m 644 README.md               ${pkgdir}/usr/share/studworks/README.md
  install -m 644 documentation/CREDITS.txt ${pkgdir}/usr/share/studworks/CREDITS.txt
  install -m 644 LICENSE.md              ${pkgdir}/usr/share/studworks/LICENSE.md
  mkdir -p ${pkgdir}/usr/share/mime/packages/
  mkdir -p ${pkgdir}/usr/share/applications/
  mkdir -p ${pkgdir}/usr/share/icons/hicolor/scalable/mimetypes
  install -m 644 qt/studworks.xml  \
				${pkgdir}/usr/share/mime/packages/studworks.xml
  install -m 644 qt/studworks.desktop \
				${pkgdir}/usr/share/applications/studworks.desktop
  install -m 644 resources/icons/scalable/mimetypes/application-vnd.studworks.svg \
				${pkgdir}/usr/share/icons/hicolor/scalable/mimetypes/application-vnd.studworks.svg
  make INSTALL_ROOT="${pkgdir}" install
}

