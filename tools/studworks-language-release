#!/bin/bash

# compile the translation catalogs into qm files
# usage: tools/studworks-language-release [language]

set -e

directory_script="${BASH_SOURCE[0]%/*}"

# run from its own directory
if [ "${directory_script}" = "${BASH_SOURCE[0]}" ]
then
	directory_script="."
fi

directory_source="$(cd "${directory_script}/.." && pwd)"
directory_translations="${directory_source}/resources/translations"

language="${1:-*}"

tool_release="$(command -v lrelease || command -v lrelease-qt5)"

for file_catalog in "${directory_translations}"/studworks_${language}.ts
do
	if [ ! -f "${file_catalog}" ]
	then
		printf "%s\n" "language not found: ${1}"
		exit 1
	fi

	"${tool_release}" -silent "${file_catalog}" -qm "${file_catalog%.ts}.qm"
done
