#!/bin/bash

# bump the release date version when main gets code changes after its release
# enable with: git config core.hooksPath tools/hooks

set -e

directory_source="$(git rev-parse --show-toplevel)"

cd "${directory_source}"

name_remote="${1}"

# only a push of the current main to main is bumped
state_main=0

while read -r ref_local sha_local ref_remote sha_remote
do
	if [ "${ref_remote}" = "refs/heads/main" ] && [ "${ref_local}" = "refs/heads/main" ] && [ "${sha_local}" = "$(git rev-parse HEAD)" ]
	then
		state_main=1
	fi
done

if [ "${state_main}" = 0 ] || [ "$(git branch --show-current)" != "main" ]
then
	exit 0
fi

while IFS= read -r line_global
do
	if [[ ${line_global} =~ SW_VERSION_TEXT\ \"([0-9-]+)\" ]]
	then
		version_old="${BASH_REMATCH[1]}"
		break
	fi
done < source/application/sw_global.h

printf -v version_today "%(%Y-%m-%d)T" -1

# a version is bumped once its release exists and only on a later day
if [ -z "${version_old}" ] || [[ ! ${version_today} > ${version_old} ]]
then
	exit 0
fi

# the release tag is read from the remote, local tags may be missing or stale
# an annotated tag lists its commit last
mapfile -t lines_release < <(git ls-remote "${name_remote}" "refs/tags/${version_old}" "refs/tags/${version_old}^{}" || true)

if [ "${#lines_release[@]}" = 0 ]
then
	exit 0
fi

sha_release="${lines_release[-1]%%[[:space:]]*}"

if [ -z "${sha_release}" ] || [ -z "$(git cat-file -t "${sha_release}" 2> /dev/null)" ]
then
	exit 0
fi

# code changes only, documentation and tools do not make a release
paths_code=(source resources ':!resources/translations' platform packaging '*.pro' '*.pri')

if [ -z "$(git diff --name-only "${sha_release}" HEAD -- "${paths_code[@]}")" ]
then
	exit 0
fi

if [ -n "$(git status --porcelain --untracked-files=no)" ]
then
	printf "%s\n" "version bump needed but the working tree has uncommitted changes, commit them and push again"
	exit 1
fi

# the last notice shows the style of the new one
lines_example=()
state_notice=0

while IFS= read -r line_file
do
	if [[ ${line_file} =~ ^\ \ \<summary\>[0-9]{4}-[0-9]{2}-[0-9]{2}\</summary\>$ ]]
	then
		if [ "${state_notice}" = 1 ]
		then
			break
		fi

		state_notice=1
	elif [ "${state_notice}" = 1 ] && [[ ${line_file} == "  - "* ]]
	then
		lines_example+=("${line_file#  }")
	fi
done < NOTICE.md

printf "%s\n" "version ${version_old} is released and code changed since, writing the ${version_today} notice"

prompt_notice="Write the release notice for StudWorx version ${version_today}, covering the changes since version ${version_old}.
Read them with git log and git diff ${sha_release} HEAD, user facing changes only.
Answer with 2 to 8 lines and nothing else, each line starting with '- ', short and plain, no final period, written like these lines of the previous notice:
$(printf "%s\n" "${lines_example[@]}")
Always write LEGO® for the brand, and part, never piece.
When no change is user facing, answer only NONE."

text_notice="$(claude -p "${prompt_notice}" --allowedTools "Bash(git log:*)" "Bash(git diff:*)" "Bash(git show:*)" "Read" "Grep" "Glob" < /dev/null)" || text_notice=""

lines_notice=()

while IFS= read -r line_notice
do
	if [[ ${line_notice} == "- "* ]]
	then
		lines_notice+=("${line_notice}")
	fi
done <<< "${text_notice}"

# changes nobody sees make no release
if [ "${#lines_notice[@]}" = 0 ] && [[ ${text_notice} == *NONE* ]]
then
	printf "%s\n" "no user facing changes, version stays ${version_old}"
	exit 0
fi

if [ "${#lines_notice[@]}" = 0 ]
then
	printf "%s\n" "no notice written, run tools/studworx-version-update, write the notice and push again"
	exit 1
fi

tools/studworx-version-update "${version_today}" > /dev/null

# the notice lines go under the new summary
mapfile -t lines_file < NOTICE.md
lines_result=()
state_insert=0

for line_file in "${lines_file[@]}"
do
	lines_result+=("${line_file}")

	if [ "${state_insert}" = 0 ] && [ "${line_file}" = "  <summary>${version_today}</summary>" ]
	then
		lines_result+=("" "${lines_notice[@]/#/  }")
		state_insert=1
	fi
done

printf "%s\n" "${lines_result[@]}" > NOTICE.md

git commit --quiet --all --message "Code & Features Update"

printf "%s\n" "version ${version_today}:" "${lines_notice[@]}"

# the bump commit goes out instead of the original push
git push --no-verify "${name_remote}" main

printf "%s\n" "pushed with the version bump, the original push is cancelled"
exit 1
