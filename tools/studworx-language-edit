#!/bin/bash

# open the translation catalogs in qt linguist
# usage: tools/studworx-language-edit [language]

set -e

directory_script="${BASH_SOURCE[0]%/*}"

# run from its own directory
if [ "${directory_script}" = "${BASH_SOURCE[0]}" ]
then
	directory_script="."
fi

directory_source="$(cd "${directory_script}/.." && pwd)"
directory_translations="${directory_source}/resources/translations"

language="${1:-*}"

tool_edit="$(command -v linguist || command -v linguist-qt5)"

list_catalogs=("${directory_translations}"/studworx_${language}.ts)

if [ ! -f "${list_catalogs[0]}" ]
then
	printf "%s\n" "language not found: ${1}"
	exit 1
fi

"${tool_edit}" "${list_catalogs[@]}"
