# Application start, settings, commands and shortcuts.

INCLUDEPATH += $$PWD

SOURCES += \
	$$PWD/lc_application.cpp \
	$$PWD/lc_commands.cpp \
	$$PWD/lc_profile.cpp \
	$$PWD/lc_shortcuts.cpp \
	$$PWD/qtmain.cpp

HEADERS += \
	$$PWD/lc_application.h \
	$$PWD/lc_commands.h \
	$$PWD/lc_global.h \
	$$PWD/lc_profile.h \
	$$PWD/lc_shortcuts.h
