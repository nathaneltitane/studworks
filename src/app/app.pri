# Application start, settings, commands and shortcuts.

INCLUDEPATH += $$PWD

SOURCES += \
	$$PWD/sw_application.cpp \
	$$PWD/sw_commands.cpp \
	$$PWD/sw_profile.cpp \
	$$PWD/sw_shortcuts.cpp \
	$$PWD/qtmain.cpp

HEADERS += \
	$$PWD/sw_application.h \
	$$PWD/sw_commands.h \
	$$PWD/sw_global.h \
	$$PWD/sw_profile.h \
	$$PWD/sw_shortcuts.h
